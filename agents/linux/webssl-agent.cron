# WEBSSL nginx agent — her gün 06:00
# Kurulum script'i (install-agent.sh) bu dosyayı sizin girdiğiniz IP ile yazar.
# Elle kullanacaksanız DASHBOARD_IP ve AGENT_TOKEN değerlerini doldurun.

0 6 * * * root CENTRAL_URL=http://DASHBOARD_IP:8080 AGENT_TOKEN=AGENT_TOKEN /usr/bin/python3 /opt/webssl-agent/webssl_agent.py >> /var/log/webssl-agent.log 2>&1
