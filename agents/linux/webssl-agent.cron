# WEBSSL nginx agent — her gün 06:00
# /etc/cron.d/webssl-agent olarak kopyalayın veya crontab -e ile ekleyin.
# AGENT_TOKEN değerini Ubuntu sunucusundaki /opt/webssl/.env ile aynı yapın.

0 6 * * * root CENTRAL_URL=http://192.168.254.90:8080 AGENT_TOKEN=changeme-token /usr/bin/python3 /opt/webssl-agent/webssl_agent.py >> /var/log/webssl-agent.log 2>&1
